{
  "name": "@guoyle/dsh-todo-panel",
  "version": "1.0.0",
  "description": "DeepSeek Harness plugin: a sidebar Todos panel with done marking and due-time hints.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "todo"
  ],
  "license": "MIT",
  "author": "gypyle",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gypyle/dsh-todo-panel.git"
  },
  "homepage": "https://github.com/gypyle/dsh-todo-panel#readme",
  "bugs": {
    "url": "https://github.com/gypyle/dsh-todo-panel/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
